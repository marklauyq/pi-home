{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "oauth": { "clientName": "Claude Code" }
    },
    "n8n-gmail": {
      "url": "https://<N8N_HOST>/mcp/pi-gmail",
      "headers": {
        "Authorization": "Bearer CHANGE_ME"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth"
    },
    "qwopus": {
      "url": "http://localhost:1234/mcp"
    }
  }
}
